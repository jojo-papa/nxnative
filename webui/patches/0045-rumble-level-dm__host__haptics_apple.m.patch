+// The rumble that really reaches the Taptic Engine: the game asks for a small amplitude and the phone's engine needs
+// a stronger one to be felt, so the gain (DM_RUMBLE_GAIN) scales it. The numbers are printed, so that "no vibration"
+// can be told apart from "a vibration that is too weak to feel".
+static void rumble_level_log(float intensity, float sharpness) {
+    static float last = -1.f; static unsigned calls;
+    if (++calls % 16 && last >= 0.f && fabsf(intensity - last) < 0.05f) return;
+    last = intensity;
+    fprintf(stderr, "[dm] haptics: rumble intensity %.3f sharpness %.3f (gain %.2f)\n", intensity, sharpness, gain);
+}
 static void apply(dm_haptic_state s) {
     dispatch_async(queue, ^{ @autoreleasepool {
         if (s.epoch != dm_haptics_epoch(s.player)) return;
         NSArray<DmRumbleChannel *> *out = channels[s.player];
         for (NSUInteger i = 0; i < out.count; i++) {
             dm_haptic_level level = out.count == 2 ? dm_haptics_level(&s.motor[i], 1, gain) : dm_haptics_level(s.motor, 2, gain);
+            rumble_level_log(level.intensity, level.sharpness);
             [out[i] apply:level];
         }
     } });
