+            // A frame that is not drawn at all leaves the drawable's contents undefined, which the player sees as a
+            // white picture, and the game keeps the same window for many frames (a cutscene that changes its own
+            // window does exactly that).  Draw the part that exists instead of dropping the frame.
+            long long x0 = crop[0] < 0 ? 0 : crop[0], y0 = crop[1] < 0 ? 0 : crop[1];
+            long long x1 = x0 + (long long)crop[2], y1 = y0 + (long long)crop[3];
+            if (x1 > (long long)src.width) x1 = (long long)src.width;
+            if (y1 > (long long)src.height) y1 = (long long)src.height;
+            if (x1 <= x0 || y1 <= y0) { MLOG("[RED] present crop is empty after clamping"); return 0; }
+            cx = (NSUInteger)x0; cy = (NSUInteger)y0; cw = (NSUInteger)(x1 - x0); ch = (NSUInteger)(y1 - y0);
+            MLOG("[RED] present crop clamped to %llu,%llu %llux%llu", (unsigned long long)cx, (unsigned long long)cy, (unsigned long long)cw, (unsigned long long)ch);
+        } else { cx = crop[0]; cy = crop[1]; cw = crop[2]; ch = crop[3]; }
+    }
+    {   // The crop and the sizes, one line when they change.  The Metal 4 path is the one the device presents with
+        // and it wrote nothing, so what the game asked for (its window) was invisible in the log.
+        static uint64_t last_meta[8]; uint64_t meta[8] = {src.width, src.height, cx, cy, cw, ch, dst.width, dst.height};
+        if (memcmp(meta, last_meta, sizeof meta)) { memcpy(last_meta, meta, sizeof meta);
+            MLOG("present crop (m4): source texture %lux%lu, valid %llu,%llu %llux%llu → target %lux%lu",
+                 (unsigned long)src.width, (unsigned long)src.height, (unsigned long long)cx, (unsigned long long)cy,
+                 (unsigned long long)cw, (unsigned long long)ch, (unsigned long)dst.width, (unsigned long)dst.height); } }
     present_pipeline(dst.pixelFormat);
     double dw = dst.width, dh = dst.height, s = fmin(dw / cw, dh / ch);
     MTLViewport vp = {floor((dw - cw * s) / 2), floor((dh - ch * s) / 2), round(cw * s), round(ch * s), 0, 1};
