 // buffer in a sparse pool whose pages are not all mapped has no host alias for the missing ones (reading the alias
 // stops the host with SIGBUS, as the texture path above says), and a binding that reaches past its pool ends in memory
 // that is not there at all.  The pages that are not there read as 0, which no projection matrix is made of.
+// Whether the host pages at [p, p+n) are really there.  The range of a pool can reach past its storage (a virtual
+// pool that borrows a physical pool's memory declares its own, larger size), and the pages behind the end of that
+// storage are not mapped: nvn_host_readable() does not see that (it knows the sparse virtual pools only) and
+// mtl_addr() only knows the declared range, so reading there stops the host with SIGSEGV (Odyssey's uniform buffer
+// with the projection in it: the copy of its bytes).  The kernel is asked about the pages, and the answer is kept per
+// page; a pool that changed (a sparse pool's unmap) drops the answers.
+enum { HP_PAGES = 64 };
+static int host_range_there(uint64_t p, uint64_t n) {
+    static uint64_t g_gen; static struct { uint64_t page; int ok; } g_hp[HP_PAGES];
+    uint64_t gen = atomic_load(&g_pool_gen);
+    if (gen != g_gen) { g_gen = gen; memset(g_hp, 0, sizeof g_hp); }
+    uint64_t left = n;
+    while (left) {
+        uint64_t page = p >> 12, base = p & ~(uint64_t)0xFFF;
+        unsigned s = (unsigned)((page * 0x9E3779B97F4A7C15ull) >> (64 - 6));
+        int ok;
+        if (g_hp[s].page == page + 1) ok = g_hp[s].ok;
+        else {
+            vm_size_t rs = 0; vm_region_basic_info_data_64_t vi; mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+            vm_address_t r = (vm_address_t)base;
+            ok = vm_region_64(mach_task_self(), &r, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&vi, &cnt, &obj) == KERN_SUCCESS
+                 && cnt >= VM_REGION_BASIC_INFO_COUNT_64 && (vi.protection & VM_PROT_READ)
+                 && r <= (vm_address_t)base && (vm_address_t)base + 0x1000 <= r + rs;
+            g_hp[s].page = page + 1; g_hp[s].ok = ok;
+        }
+        if (!ok) return 0;
+        uint64_t inpage = 0x1000 - (p & 0xFFF); if (inpage > left) inpage = left;
+        p += inpage; left -= inpage;
+    }
+    return 1;
+}
 static void proj_copy(uint64_t addr, uint64_t len, void *dst) {
     uint8_t *out = dst;
     for (uint64_t o = 0; o < len; o += 0x1000) {
         uint64_t chunk = len - o < 0x1000 ? len - o : 0x1000;
         void *mb; uint64_t mo;
-        if (nvn_host_readable(addr + o, chunk) && mtl_addr(addr + o, chunk, &mb, &mo)) memcpy(out + o, (const uint8_t *)mb + mo, chunk);
+        if (nvn_host_readable(addr + o, chunk) && mtl_addr(addr + o, chunk, &mb, &mo)) {
+            const uint8_t *src = (const uint8_t *)mb + mo;
+            if (host_range_there((uint64_t)(uintptr_t)src, chunk)) memcpy(out + o, src, chunk);
+            else memset(out + o, 0, chunk);
+        }
         else memset(out + o, 0, chunk);
     }
 }
