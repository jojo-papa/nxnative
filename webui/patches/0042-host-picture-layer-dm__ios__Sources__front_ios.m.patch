diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -46,7 +46,11 @@
     if ((self = [super initWithFrame:f])) {
         CAMetalLayer *l = (CAMetalLayer *)self.layer;
         l.device = MTLCreateSystemDefaultDevice(); l.pixelFormat = MTLPixelFormatBGRA8Unorm;
-        l.contentsScale = UIScreen.mainScreen.nativeScale; l.framebufferOnly = NO; l.opaque = YES;
+        // framebufferOnly off makes the compositor copy the picture on every frame to put the host's own interface
+        // over it.  The interface is all that is left of the screen when the picture is not there, so that copy is what
+        // the eye reads as the host's own page flickering.  The reflection (off by default) takes the picture from the
+        // presenter instead, which chrome_tick already does when the layer has no contents.
+        l.contentsScale = UIScreen.mainScreen.nativeScale; l.framebufferOnly = YES; l.opaque = YES;
         self.backgroundColor = UIColor.blackColor;
     }
     return self;
@@ -54,7 +58,10 @@
 - (void)layoutSubviews {
     [super layoutSubviews];
     CAMetalLayer *l = (CAMetalLayer *)self.layer;
-    l.drawableSize = CGSizeMake(self.bounds.size.width * l.contentsScale, self.bounds.size.height * l.contentsScale);
+    CGSize s = CGSizeMake(self.bounds.size.width * l.contentsScale, self.bounds.size.height * l.contentsScale);
+    if (CGSizeEqualToSize(l.drawableSize, s)) return;   // the same size: the drawables stay, nothing is reallocated
+    l.drawableSize = s;   // a new size means new drawables, and a frame with nothing in it
+    LOG("front end: the picture's drawable is now %.0fx%.0f", s.width, s.height);
 }
 @end
 
