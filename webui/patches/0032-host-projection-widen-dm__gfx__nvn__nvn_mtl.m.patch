+static double g_proj_src_aspect;       // the aspect of the game's own picture (the source of the present)
+typedef struct { uint64_t addr; uint64_t slot; uint64_t frame; int col; int found; } proj_buf;   // a uniform buffer the vertex stage binds
+enum { PROJ_MAX = 64, PROJ_SCAN_SLOTS = 1024 };   // the first 16 KB of a buffer; the projection sits at the front of it
+static proj_buf g_proj_buf[PROJ_MAX]; static int g_proj_nbuf;
+// The perspective matrix at a slot of a uniform buffer: four consecutive float4 rows. Row-major, the w row is the last one
+// (its z is the -1 of the perspective); column-major, the -1 is the w component of the third row. The x and y scales are in
+// the first two rows in both layouts.
+static int proj_signature(const float *f, uint64_t slot, int col) {
+    const float *r0 = f + slot * 4, *r1 = r0 + 4, *r2 = r0 + 8, *r3 = r0 + 12;
+    if (fabsf(r0[1]) > 1e-2f || fabsf(r0[2]) > 1e-2f || fabsf(r0[3]) > 1e-2f || fabsf(r1[0]) > 1e-2f ||
+        fabsf(r1[2]) > 1e-2f || fabsf(r1[3]) > 1e-2f || fabsf(r2[0]) > 1e-2f || fabsf(r2[1]) > 1e-2f) return 0;
+    float xs = fabsf(r0[0]), ys = fabsf(r1[1]);
+    if (!(xs > 0.3f && xs < 6.0f) || !(ys > 0.6f && ys < 4.0f)) return 0;
+    return col ? (r2[3] == -1.0f) : (r3[2] == -1.0f);
+}
+static int proj_scan(const float *f, uint64_t n, uint64_t *slot, int *col) {
+    if (n > PROJ_SCAN_SLOTS) n = PROJ_SCAN_SLOTS;
+    for (uint64_t k = 0; k + 3 < n; k++) {
+        const float *r0 = f + k * 4;
+        if (fabsf(r0[1]) > 1e-2f || fabsf(r0[2]) > 1e-2f || fabsf(r0[3]) > 1e-2f) continue;   // the first row: the x scale and nothing else
+        const float *r1 = r0 + 4, *r2 = r0 + 8, *r3 = r0 + 12;
+        if (fabsf(r1[0]) > 1e-2f || fabsf(r1[2]) > 1e-2f || fabsf(r1[3]) > 1e-2f || fabsf(r2[0]) > 1e-2f || fabsf(r2[1]) > 1e-2f) continue;
