+        if (!(xs > 0.3f && xs < 6.0f) || !(ys > 0.6f && ys < 4.0f)) continue;
+        if (r3[2] == -1.0f) { *slot = k; *col = 0; return 1; }
+        if (r2[3] == -1.0f) { *slot = k; *col = 1; return 1; }
+    }
+    return 0;
