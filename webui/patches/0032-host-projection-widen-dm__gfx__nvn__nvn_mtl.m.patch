+// The camera's projection is the one whose aspect is the aspect of the game's own picture; a shadow map's is another one. A
+// matrix that was scaled already has an aspect that is off by the scale factor, and counts too.
+static int proj_aspect_ok(double a) {
+    double want = g_proj_src_aspect > 0.1 ? g_proj_src_aspect : 16.0 / 9.0;
+    if (fabs(a - want) < 0.08) return 1;
+    if (g_proj_scale != 1.0f && fabs(a - want / g_proj_scale) < 0.08) return 1;
+    return 0;
