+// DM_SCREEN_FILL=wide: the picture fills the canvas and the game's horizontal field of view is widened by the
+// factor the picture is stretched by, so it keeps its proportions. Until the projection has been found, the picture
+// is scaled up to cover the canvas (and cropped) instead, so it is never stretched wrongly.
+static void proj_wide_viewport(double dw, double dh, double cw, double ch, MTLViewport *vp) {
+    g_proj_src_aspect = cw / ch;
+    double k = (dw / dh) / g_proj_src_aspect;
+    if (proj_widen_on() && g_proj_nbuf && k > 0.01) {
+        g_proj_scale = (float)(1.0 / k);
+        vp->originX = 0; vp->originY = 0; vp->width = dw; vp->height = dh;
+        return;
+    }
+    double s = fmax(dw / cw, dh / ch);
+    vp->originX = floor((dw - cw * s) / 2); vp->originY = floor((dh - ch * s) / 2); vp->width = round(cw * s); vp->height = round(ch * s);
 }
