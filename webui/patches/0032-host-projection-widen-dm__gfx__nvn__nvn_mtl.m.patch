+         r0[0], r0[1], r0[2], r0[3], r0[4], r0[5], r0[6], r0[7], r0[8], r0[9], r0[10], r0[11], r0[12], r0[13], r0[14], r0[15]);
+}
+// The host's copy of the game's upload: the row that the vertex shader multiplies for clip.x is scaled, which widens the
+// horizontal field of view by the factor the picture is stretched by. The game's own memory and the GPU read the same matrix.
+static void proj_scale_upload(uint8_t *ring, uint64_t dst, uint64_t n) {
+    if (g_proj_scale == 1.0f || !g_proj_nbuf) return;
+    for (int i = 0; i < g_proj_nbuf; i++) {
+        if (!g_proj_buf[i].found) continue;   // a buffer without a projection is left alone
+        uint64_t base = g_proj_buf[i].addr + g_proj_buf[i].slot * 16;
+        for (int j = 0; j < 4; j++) {
+            uint64_t fa = base + (g_proj_buf[i].col ? (uint64_t)j * 16 : (uint64_t)j * 4);   // the x scale of the row, or the x component of the column
+            if (fa + 4 <= dst || fa >= dst + n) continue;   // not in this upload
+            float *fp = (float *)(ring + (fa - dst));
+            *fp *= g_proj_scale;
+        }
+    }
+}
