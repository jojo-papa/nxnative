 @class DmChromeBar;
 
 static BOOL env_on(const char *name, int fallback) { const char *e = getenv(name); return e ? atoi(e) != 0 : fallback != 0; }
+// DM_SCREEN_FILL: how the game picture fills the screen. 0 = fit (the default): the picture keeps its aspect
+// ratio and the bars around it stay black; 1 = cover: the picture is scaled up until the screen is covered (the
+// edges are cut off); 2 = stretch: the picture fills the screen without keeping its aspect ratio. nvn_mtl.m reads
+// the same variable and scales the picture into the canvas: the canvas must have the screen's shape in the two
+// latter modes, or the bars would appear twice (once around the canvas, once inside it).
+static int dm_screen_fill_mode(void) {
+    const char *e = getenv("DM_SCREEN_FILL");
+    if (!e || !*e) return 0;
+    if (!strcmp(e, "cover") || !strcmp(e, "1")) return 1;
+    if (!strcmp(e, "stretch")) return 2;
+    return 0;
+}
 void dm_audio_set_user_gain(float g);   // hle_audio.c: the slider's gain, on top of the game's own output gain
 void mtl_grab_next_present(void (^cb)(CGImageRef img));   // nvn_mtl.m: the next presented frame as an image
 
