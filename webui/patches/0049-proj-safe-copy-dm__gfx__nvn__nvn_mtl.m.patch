 // Look for the projection in a uniform buffer the vertex stage binds. The same buffer is bound again for every draw, so a
 // buffer that holds the projection is only checked at its own slot (the content changes with the camera, the slot does not).
 // A buffer without a projection is looked at again only once a second: the scan must not cost anything per draw.
+// The bytes of the guest memory at [addr, addr+len) into the caller's buffer: they may not all be there.  A uniform
+// buffer in a sparse pool whose pages are not all mapped has no host alias for the missing ones (reading the alias
+// stops the host with SIGBUS, as the texture path above says), and a binding that reaches past its pool ends in memory
+// that is not there at all.  The pages that are not there read as 0, which no projection matrix is made of.
+static void proj_copy(uint64_t addr, uint64_t len, void *dst) {
+    uint8_t *out = dst;
+    for (uint64_t o = 0; o < len; o += 0x1000) {
+        uint64_t chunk = len - o < 0x1000 ? len - o : 0x1000;
+        void *mb; uint64_t mo;
+        if (nvn_host_readable(addr + o, chunk) && mtl_addr(addr + o, chunk, &mb, &mo)) memcpy(out + o, (const uint8_t *)mb + mo, chunk);
+        else memset(out + o, 0, chunk);
+    }
+}
