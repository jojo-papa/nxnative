 static int dm_screen_fill_mode(void);   // further down, with the chrome
+// The screen's own aspect (the App is landscape only, so this is the width over the height).
+static double front_ios_screen_aspect(CGSize b) { return b.width > 0 && b.height > 0 ? fmax(b.width, b.height) / fmin(b.width, b.height) : 16.0 / 9.0; }
+// DM_SCREEN_FILL=wide stretches the picture horizontally and widens the horizontal field of view by the same factor, so
+// the picture keeps its proportions and fills the screen.  That only works on a screen that is wider than the game's
+// 16:9.  On a narrower one (a 4:3 tablet) the picture would have to be stretched vertically instead, and the host's
+// compensation only corrects the horizontal direction: everything would be pulled up and down.  There the vertical
+// direction takes the chrome: the picture keeps its 16:9 and the bars above and below it belong to the chrome.  The
+// screen's own aspect decides, so one package serves a phone and a tablet.
 double front_ios_canvas_aspect(CGSize b) {   // DmGamepad.m maps touches on the same canvas
-    double a = b.width > 0 && b.height > 0 ? fmax(b.width, b.height) / fmin(b.width, b.height) : 16.0 / 9.0;
-    if (dm_screen_fill_mode() == 2 || dm_screen_fill_mode() == 3) return a;   // the picture covers the whole screen
+    double a = front_ios_screen_aspect(b);
+    if (dm_screen_fill_mode() == 2) return a;   // stretch: the picture covers the whole screen
+    if (dm_screen_fill_mode() == 3 && a > 16.0 / 9.0) return a;   // wide, on a screen that is wider than 16:9
     return front_ios_wide() ? fmax(a, 16.0 / 9.0) : 16.0 / 9.0;
+}
+// Whether the picture covers the whole screen (there are no bars around it): the cover and the stretch modes always do,
+// the wide mode only where the canvas has the screen's own shape (see above).
+static int front_ios_fills_screen(CGSize b) {
+    int fill = dm_screen_fill_mode();
+    if (fill == 1 || fill == 2) return 1;
+    if (fill == 3) return fabs(front_ios_canvas_aspect(b) - front_ios_screen_aspect(b)) < 1e-9;
+    return 0;
 }
 double front_screen_aspect(void) { return front_ios_wide() ? g_canvas_aspect : 0; }   // set on the main thread before the host starts the game (startGame)
 
