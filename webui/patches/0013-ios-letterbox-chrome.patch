+
+// The backdrop, the reflection and the shortcut buttons. The backdrop and the reflection go into one
+// layer behind the picture (which covers the middle of the screen), so only the bars around it show them;
+// the buttons are views over the picture, where they can be touched.
+- (void)build_chrome {
+    CALayer *host = [CALayer layer];
+    [self.view.layer insertSublayer:host atIndex:0];   // behind every subview (the picture, the pad)
+    g_chrome_layer = host;
+    CAGradientLayer *bg = [CAGradientLayer layer];
+    bg.colors = @[(id)[UIColor colorWithRed:0.055 green:0.065 blue:0.095 alpha:1].CGColor,
+                  (id)[UIColor colorWithRed:0.012 green:0.015 blue:0.024 alpha:1].CGColor];
+    bg.startPoint = CGPointMake(0.5, 0); bg.endPoint = CGPointMake(0.5, 1);
+    [host addSublayer:bg];
+    g_backdrop = bg;
+    UIImage *im = chrome_backdrop_image();
+    if (im) {
+        CALayer *il = [CALayer layer];
+        il.contents = (id)im.CGImage;
+        il.contentsGravity = kCAGravityResizeAspectFill;
+        il.masksToBounds = YES;
+        [host addSublayer:il];
+        g_backdrop_image = il;
+    }
+    if (env_on("DM_REFLECT", 1)) {
+        CALayer *r = [CALayer layer];
+        r.contentsGravity = kCAGravityResizeAspect;
+        [host addSublayer:r];
+        g_reflection = r;
+    }
+    self.chrome = [[DmChromeBar alloc] initWithFrame:CGRectZero];
+    self.chrome.onAction = ^(NSString *what) { [g_root chrome_action:what]; };
+    self.chrome.onVolume = ^(float gain) { dm_audio_set_user_gain(gain); };
+    [self.view addSubview:self.chrome];
+    g_chrome = self.chrome;
+    g_toast = [[UILabel alloc] initWithFrame:CGRectZero];
+    g_toast.textAlignment = NSTextAlignmentCenter;
+    g_toast.textColor = UIColor.whiteColor;
+    g_toast.font = [UIFont systemFontOfSize:15 weight:UIFontWeightSemibold];
+    g_toast.backgroundColor = [UIColor colorWithWhite:0 alpha:0.55];
+    g_toast.layer.cornerRadius = 10; g_toast.layer.masksToBounds = YES;
+    g_toast.alpha = 0; g_toast.userInteractionEnabled = NO;
+    [self.view addSubview:g_toast];
+    if (!g_reflect_link) {
+        g_reflect_link = [CADisplayLink displayLinkWithTarget:self selector:@selector(chrome_tick)];
+        g_reflect_link.preferredFrameRateRange = CAFrameRateRangeMake(10, 30, 30);   // the reflection does not need the full frame rate
+        [g_reflect_link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+    }
+    LOG("front end: letterbox chrome on (backdrop %s, reflection %s)", im ? "image" : "gradient", env_on("DM_REFLECT", 1) ? "on" : "off");
+}
+
+// The reflection shows the picture's last presented frame, mirrored into a bar. The game layer keeps the
+// picture in its contents (framebufferOnly is off), so no copy of the pixels is made here; when it does
+// not, the picture is taken from the presenter instead, every third tick, so the readback does not cost
+// the game its frame rate.
+- (void)chrome_tick {
+    if (!g_reflection || !self.game) return;
+    id c = ((CALayer *)self.game.layer).contents;
+    if (c) { g_reflection.contents = c; g_reflect_ticks = 0; return; }
+    if (g_reflect_ticks++ % 3) return;
+    static int busy;
+    if (busy) return;
+    busy = 1;
+    mtl_grab_next_present(^(CGImageRef img) {
+        if (!img) { dispatch_async(dispatch_get_main_queue(), ^{ busy = 0; }); return; }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (g_reflection) g_reflection.contents = (__bridge id)img;
+            CGImageRelease(img);
+            busy = 0;
+        });
+    });
+}
+
+// The three buttons: a screenshot of the next presented frame, the frame-rate counter and the chrome
+// itself.
+- (void)chrome_action:(NSString *)what {
+    if ([what isEqualToString:@"shot"]) {
+        static int n;
+        NSString *doc = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+        NSString *p = [doc stringByAppendingPathComponent:[NSString stringWithFormat:@"screenshot-%d.png", ++n]];
+        dm_gfx_shot_at(1, p.UTF8String);
+        chrome_toast([NSString stringWithFormat:@"已保存 %@", p.lastPathComponent]);
+    } else if ([what isEqualToString:@"fps"]) {
+        int on = self.fps != nil;
+        if (on) { [self.fps removeFromSuperview]; self.fps = nil; }
+        else { self.fps = front_ios_fps_label(); if (self.fps) [self.view addSubview:self.fps]; }
+        setenv("DM_SHOW_FPS", on ? "0" : "1", 1);
+        [self.view setNeedsLayout];
+        chrome_toast(on ? @"帧率计数 关" : @"帧率计数 开");
+    } else if ([what isEqualToString:@"hide"]) {
+        g_chrome_hidden = !g_chrome_hidden;
+        if (g_chrome) g_chrome.hidden = g_chrome_hidden;
+        if (g_chrome_layer) g_chrome_layer.hidden = g_chrome_hidden;
+        chrome_toast(g_chrome_hidden ? @"已隐藏界面" : @"已显示界面");
+    }
+}
+
+// Where the buttons go. The upper bar is shared with the virtual gamepad's top row: ZL / ZR in the
+// corners, L3 / R3 inboard of them, the - / + keys and the layout button at the top centre (all in the
+// gamepad's own unit u). The free stretch is between the centre cluster and R3; the frame-rate counter
+// sits in the other one. When the bars are beside the picture (a phone in 19:5) the buttons become a
+// column in the right-hand one, inside the safe area.
+- (void)layout_chrome:(dm_letterbox)L {
+    if (!self.chrome) return;
+    CGRect b = self.view.bounds, safe = UIEdgeInsetsInsetRect(b, self.view.safeAreaInsets);
+    CGFloat u = MIN(b.size.height / 430.0, 1.3), mid = b.size.width / 2, pad = 8;
+    BOOL slider = env_on("DM_VOLUME", 1);
+    if (L.top.size.height >= 56) {
+        CGFloat x0 = mid + 77 * u + pad, x1 = b.size.width - 119 * u - pad;
+        if (x1 - x0 < 150) { x0 = 119 * u + pad; x1 = mid - 77 * u - pad; }
+        if (x1 - x0 < 150) { x0 = pad; x1 = b.size.width - pad; }
+        CGFloat h = (slider && L.top.size.height >= 64) ? 64 : 32;
+        self.chrome.frame = CGRectMake(x0, pad, x1 - x0, h);
+        [self.chrome arrange:self.chrome.bounds vertical:NO slider:(slider && h >= 64)];
+    } else if (L.right.size.width >= 56) {
+        CGFloat w = MIN(L.right.size.width - 8, 64);
+        CGFloat x = MAX(CGRectGetMinX(safe), MIN(CGRectGetMaxX(L.game) + 4, CGRectGetMaxX(safe) - w));
+        self.chrome.frame = CGRectMake(x, CGRectGetMidY(L.game) - 60, w, 120);
+        [self.chrome arrange:self.chrome.bounds vertical:YES slider:NO];
+    } else {
+        self.chrome.frame = CGRectMake(CGRectGetMaxX(L.game) - 220, CGRectGetMinY(L.game) + 8, 212, 32);
+        [self.chrome arrange:self.chrome.bounds vertical:NO slider:NO];
+    }
+    self.chrome.hidden = g_chrome_hidden;
+}
 @end
 UIViewController *front_ios_root(void) { return [DmRootVC new]; }
 
