+// ===== The letterbox chrome =====
+// The 16:9 picture sits in the middle of the screen, so a black bar is left around it: above and below on
+// a 4:3 tablet, on the sides in 19:5 on a phone. Those bars are put to use: a backdrop (the player's own
+// image, dropped into Documents/frame.png, or a gradient), a reflection of the picture mirrored into a bar
+// and fading out, and the shortcut buttons. Every part can be switched off from the device
+// (DM_CHROME / DM_REFLECT / DM_VOLUME in Documents/env.txt; no rebuild needed).
+@class DmChromeBar;
+
+static BOOL env_on(const char *name, int fallback) { const char *e = getenv(name); return e ? atoi(e) != 0 : fallback != 0; }
+void dm_audio_set_user_gain(float g);   // hle_audio.c: the slider's gain, on top of the game's own output gain
+void mtl_grab_next_present(void (^cb)(CGImageRef img));   // nvn_mtl.m: the next presented frame as an image
+
+static CALayer *g_chrome_layer;        // the backdrop and the reflection, behind the picture
+static CALayer *g_reflection;          // the mirrored picture
+static CADisplayLink *g_reflect_link;
+static CAGradientLayer *g_backdrop;    // the gradient the bars show
+static CALayer *g_backdrop_image;      // the player's own image (Documents/frame.png)
+static DmChromeBar *g_chrome;          // the shortcut buttons
+static UILabel *g_toast;               // a short notice after a button press
+static BOOL g_chrome_hidden;
+static int g_reflect_ticks;            // the reflection's own clock (the fallback path takes every third tick)
+
+// The picture's rect in the screen and the free bars around it.
+typedef struct { CGRect game, top, bottom, left, right; } dm_letterbox;
+static dm_letterbox front_ios_letterbox(CGRect b) {
+    dm_letterbox L;
+    CGFloat w = b.size.width, h = b.size.height, gw = w, gh = h;
+    if (w / h > 16.0 / 9.0) gw = h * 16.0 / 9.0; else gh = w * 9.0 / 16.0;
+    L.game = CGRectMake(floor((w - gw) / 2), floor((h - gh) / 2), floor(gw), floor(gh));
+    CGFloat gy = CGRectGetMinY(L.game), gb = CGRectGetMaxY(L.game), gx = CGRectGetMinX(L.game), gr = CGRectGetMaxX(L.game);
+    L.top = CGRectMake(0, 0, w, gy);
+    L.bottom = CGRectMake(0, gb, w, h - gb);
+    L.left = CGRectMake(0, 0, gx, h);
+    L.right = CGRectMake(gr, 0, w - gr, h);
+    return L;
+}
+
+// A short notice over the picture.
+static void chrome_toast(NSString *text) {
+    if (!g_toast) return;
+    g_toast.text = text; g_toast.alpha = 1;
+    [UIView animateWithDuration:0.3 delay:1.8 options:0 animations:^{ g_toast.alpha = 0; } completion:nil];
+}
+
+// The player's own backdrop image, if there is one: Documents/frame.png (the Files app can put it there).
+static UIImage *chrome_backdrop_image(void) {
+    NSString *doc = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+    for (NSString *name in @[@"frame.png", @"chrome.png", @"mask.png"]) {
+        NSString *p = [doc stringByAppendingPathComponent:name];
+        if ([NSFileManager.defaultManager fileExistsAtPath:p]) {
+            UIImage *im = [UIImage imageWithContentsOfFile:p];
+            if (im) { LOG("front end: letterbox backdrop %s (%lux%lu)", name.UTF8String, (unsigned long)im.size.width, (unsigned long)im.size.height); return im; }
+        }
+    }
+    return nil;
+}
+
+// The mask that fades the reflection out towards the far end of the bar. It is drawn in the reflection
+// layer's own space, where the far end of the bar is the start of it: the fade therefore runs over the
+// last `bar` fraction of the layer (the part that sticks out of the screen).
+static CAGradientLayer *chrome_fade(CGFloat bar_fraction) {
+    CAGradientLayer *m = [CAGradientLayer layer];
+    CGFloat f = 1.f - MAX(0.f, MIN(1.f, bar_fraction));
+    m.colors = @[(id)[UIColor colorWithWhite:0 alpha:0].CGColor,
+                  (id)[UIColor colorWithWhite:0 alpha:0].CGColor,
+                  (id)[UIColor colorWithWhite:0 alpha:1].CGColor];
+    m.locations = @[@0, @(f), @1];
+    return m;
+}
+
+// The shortcut buttons: a screenshot of the next presented frame, the frame-rate counter, the chrome
+// itself and the volume. A row in the upper bar when the bars are above and below the picture (a
+// tablet), a column in the right-hand bar when they are beside it (a phone in 19:5).
+@interface DmChromeBar : UIView
+@property (nonatomic, strong) NSArray<UIButton *> *buttons;
+@property (nonatomic, strong) UISlider *volume;
+@property (nonatomic, copy) void (^onAction)(NSString *what);
+@property (nonatomic, copy) void (^onVolume)(float gain);
+@end
+@implementation DmChromeBar
+- (UIButton *)button:(NSString *)title action:(SEL)action {
+    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+    [b setTitle:title forState:UIControlStateNormal];
+    [b setTitleColor:UIColor.whiteColor forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont systemFontOfSize:13 weight:UIFontWeightSemibold];
+    b.backgroundColor = [UIColor colorWithWhite:1 alpha:0.14];
+    b.layer.cornerRadius = 8; b.layer.masksToBounds = YES;
+    b.contentEdgeInsets = UIEdgeInsetsMake(6, 12, 6, 12);
+    [b addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+    return b;
+}
+- (instancetype)initWithFrame:(CGRect)f {
+    if ((self = [super initWithFrame:f])) {
+        self.backgroundColor = UIColor.clearColor;
+        UIButton *shot = [self button:@"截屏" action:@selector(onShot)];
+        UIButton *fps = [self button:@"FPS" action:@selector(onFps)];
+        UIButton *hide = [self button:@"隐藏" action:@selector(onHide)];
+        self.buttons = @[shot, fps, hide];
+        for (UIButton *b in self.buttons) [self addSubview:b];
+        UISlider *s = [[UISlider alloc] init];
+        s.minimumValue = 0; s.maximumValue = 2; s.value = 1;
+        s.minimumTrackTintColor = UIColor.whiteColor;
+        s.maximumTrackTintColor = [UIColor colorWithWhite:1 alpha:0.25];
+        [s addTarget:self action:@selector(onVol:) forControlEvents:UIControlEventValueChanged];
+        self.volume = s;
+        [self addSubview:s];
+    }
+    return self;
+}
+// Lay the buttons out in a row or a column inside the bar; the slider, when it is shown, goes under the
+// row (a column has no room for it).
+- (void)arrange:(CGRect)f vertical:(BOOL)vertical slider:(BOOL)slider {
+    CGFloat x = CGRectGetMinX(f), y = CGRectGetMinY(f), gap = 8, bh = 32;
+    for (UIButton *b in self.buttons) {
+        CGSize s = [b sizeThatFits:CGSizeMake(240, bh)];
+        if (vertical) { b.frame = CGRectMake(x + (CGRectGetWidth(f) - s.width) / 2, y, s.width, bh); y += bh + gap; }
+        else { b.frame = CGRectMake(x, y + (slider ? 0 : (CGRectGetHeight(f) - bh) / 2), s.width, bh); x += s.width + gap; }
+    }
+    self.volume.hidden = !slider;
+    if (slider) {
+        CGFloat sw = MIN(110, CGRectGetWidth(f));
+        if (vertical) self.volume.frame = CGRectMake(x + (CGRectGetWidth(f) - sw) / 2, y, sw, bh);
+        else self.volume.frame = CGRectMake(CGRectGetMinX(f), CGRectGetMaxY(f) - bh, sw, bh);
+    }
+}
+- (void)onShot { if (self.onAction) self.onAction(@"shot"); }
+- (void)onFps { if (self.onAction) self.onAction(@"fps"); }
+- (void)onHide { if (self.onAction) self.onAction(@"hide"); }
+- (void)onVol:(UISlider *)s { if (self.onVolume) self.onVolume(s.value); }
+@end
+
