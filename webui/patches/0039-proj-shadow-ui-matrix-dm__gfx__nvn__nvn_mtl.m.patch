+
+// DM_PROJ_WIDEN: a buffer the game writes itself (its own memory pool, mapped, so the bytes never travel through the
+// host's update path) keeps the game's own matrix, and the GPU would read it unscaled: the 2D interface is then
+// stretched by the difference between the screen's aspect and the picture's.  For such a buffer the host binds a copy
+// of it with the x scale corrected.  The game's own memory stays exactly as the game wrote it, so the game still
+// computes its 2D layout and its touch hit boxes from the matrix it wrote itself.
+static id<MTLBuffer> proj_shadow(uint64_t addr, uint64_t size, uint64_t *gpu_out) {
+    if (!g_proj_scale || g_proj_scale == 1.0f || !size) return nil;
+    for (int i = 0; i < g_proj_nbuf; i++) {
+        if (!g_proj_buf[i].found || g_proj_buf[i].addr != addr) continue;
+        uint64_t base = g_proj_buf[i].addr + g_proj_buf[i].slot * 16;
+        if (base < addr || base + 16 > addr + size) continue;
+        id<MTLBuffer> buf; size_t off = arena_alloc((size_t)size, &buf);
+        uint8_t *dst = (uint8_t *)buf.contents + off;
+        memcpy(dst, (const void *)addr, (size_t)size);
+        for (int j = 0; j < 4; j++) {
+            uint64_t fa = base + (g_proj_buf[i].col ? (uint64_t)j * 16 : (uint64_t)j * 4);   // the x scale of the row, or the x component of the column
+            if (fa + 4 > addr + size) continue;
+            *(float *)(dst + (fa - addr)) *= g_proj_scale;
+        }
+        *gpu_out = buf.gpuAddress + off;
+        g_proj_shadow_n++;
+        return buf;
+    }
+    return nil;
 }
 
